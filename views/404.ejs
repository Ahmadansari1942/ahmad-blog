<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= (typeof code !== 'undefined' ? code : 404) %> — AhmadBlog</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div style="text-align:center;padding:4rem;font-family:sans-serif;background:#0d0d0d;color:#fff;min-height:100vh">
    <h1 style="font-size:4rem;color:#e85d24"><%= (typeof code !== 'undefined' ? code : 404) %></h1>
    <p style="font-size:1.2rem;color:#aaa"><%= (typeof message !== 'undefined' ? message : 'Page not found') %></p>
    <a href="/" style="color:#e85d24;text-decoration:none;font-size:1rem">← Back to Home</a>
  </div>
</body>
</html>
